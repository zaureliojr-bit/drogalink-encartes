{
  "name": "drogalink-encartes",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Gerador de encartes de ofertas da Drogaria Mais Barato. Aplicação estática em módulos ES, sem bundler.",
  "homepage": "https://encartes.drogalink.com.br",
  "repository": {
    "type": "git",
    "url": "https://github.com/zaureliojr-bit/drogalink-encartes.git"
  },
  "scripts": {
    "dev": "npx --yes http-server . -p 5173 -c-1 -o",
    "build": "npx --yes esbuild src/main.js --bundle --minify --format=esm --outfile=dist/app.js",
    "check": "node --check src/main.js"
  },
  "keywords": ["encarte", "farmacia", "ofertas", "drogalink"],
  "license": "UNLICENSED"
}
